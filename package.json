{
  "name": "omnia",
  "productName": "omnia",
  "version": "0.11.0",
  "description": "An Electron desktop workspace for isolated web applications and configurable multi-pane layouts.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "cross-env ELECTRON_RUN_AS_NODE= electron-forge start",
    "build": "npm run package",
    "package": "cross-env NODE_ENV=production electron-forge package",
    "make": "cross-env NODE_ENV=production electron-forge make",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage.enabled --coverage.reporter=json --coverage.reporter=text",
    "crap": "crap-typescript --agent --threshold 8",
    "crap:changed": "crap-typescript --changed --agent --threshold 8",
    "crap:report": "crap-typescript --threshold 8 --format json --output reports/crap.json --junit-report reports/crap-junit.xml",
    "quality": "npm run lint && npm run typecheck && npm run test:coverage && npm run crap && npm run build"
  },
  "build": {
    "appId": "com.strielok.omnia",
    "productName": "Omnia",
    "icon": "src/assets/icon.png"
  },
  "keywords": [
    "electron",
    "react",
    "multi tasking",
    "social media",
    "productivity"
  ],
  "author": {
    "name": "Michał Lach",
    "email": "kontakt@michal-lach.pl"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@barney-media/crap-typescript": "^0.5.0",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.27",
    "babel-loader": "^10.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "electron": "github:castlabs/electron-releases#v40.1.0+wvcus",
    "encoding": "^0.1.13",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "iconv-lite": "^0.6.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@heroui/react": "^3.0.1",
    "@heroui/styles": "^3.0.1",
    "@osmn-byhn/electron-make-pacman": "^1.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "postcss-loader": "^8.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.12"
  }
}
