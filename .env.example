# These defaults target the hosted Omnia services. The OIDC client ID is a
# public native-app identifier; override the API URL for another route service.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_REDIRECT_URI=omnia://auth/callback
OMNIA_API_BASE_URL=https://omnia.pripyat.cloud

# Set to true only on an Arch build host with makepkg available.
OMNIA_BUILD_PACMAN=false
